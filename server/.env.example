# Copy to .env for local dev, or set these in the Render web service's Environment.

# Resend API key (reuse BuildGen's, or a new one). Without it, the endpoint accepts
# submissions but does not email them.
RESEND_API_KEY=

# Where enquiries are delivered.
TO_EMAIL=nathan.veley@themoultongroup.ca

# Verified Resend sender. Verify pathwaydistribution.ca in Resend, or temporarily
# reuse a sender on an already-verified domain.
FROM_EMAIL=Pathway Distribution <notifications@pathwaydistribution.ca>

# Site origin(s) allowed to call this API (comma-separate apex + www + preview).
ALLOWED_ORIGIN=https://pathwaydistribution.ca,https://www.pathwaydistribution.ca

# Local port (Render sets PORT automatically).
PORT=3001
